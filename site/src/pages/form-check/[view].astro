---
// Named results. Built for private previews only, never for production.
import Base from "@/layouts/Base.astro";
import FormCheckNamed from "@/components/form-check-named";
import { loadCensus } from "@/lib/census";
import { ranked } from "@/lib/form-check";
import { builtOn, isProduction } from "@/lib/build-env";

export function getStaticPaths() {
  return isProduction ? [] : [{ params: { view: "named" } }];
}

const groups = ranked(loadCensus());
---
<Base
  title="Form check: named results (private preview) | Kinderform"
  description="Private preview. Not for publication."
  noindex
>
  <FormCheckNamed groups={groups} built={builtOn} />
</Base>
