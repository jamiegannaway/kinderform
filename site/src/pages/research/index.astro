---
import Base from "@/layouts/Base.astro";
import ResearchIndex, { longDate } from "@/components/research";
import { getCollection } from "astro:content";
import { evidenceEntries, hrefOf, libraryUpdated, monthOf, titleOf } from "@/lib/research";
import findingsFile from "../../../../evidence/findings.json";
import { loadCensus } from "@/lib/census";
import { formsDiffer } from "@/lib/forms-differ";
import { usPicture } from "@/lib/us-register";
import { countries } from "@/lib/countries";

// Keep the order of findings.json: it is the order we want people to read them in.
const order = findingsFile.findings.map((f) => f.id);
const findings = (await getCollection("findings"))
  .map((f) => f.data)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const { library, reports, updates } = await evidenceEntries();
const libUpdated = libraryUpdated(library?.body);
// The intake-form census, as unnamed patterns (see src/lib/forms-differ.ts).
const differ = formsDiffer(loadCensus());
// The US front-door register, as counts with no names (see src/lib/us-register.ts).
const us = usPicture();
// First-contact forms in four countries, measured the same way (see src/lib/countries.ts).
const world = countries(loadCensus());

// The withdrawals card at the top quotes the checked "withdrawals" finding. Read its
// figures from the finding itself, and stop the build if the wording changes so they
// can no longer be found.
const wf = findings.find((f) => f.id === "withdrawals");
let withdrawals;
if (wf) {
  const m = wf.summary.match(/Of the ([\d,]+) applications that finished[^,]*, services approved ([\d,]+) and ([\d,]+) ended in withdrawal.*?(\d+)%/);
  if (!m) throw new Error('evidence/findings.json "withdrawals": cannot find the completed, approved and withdrawn figures for the card at the top of /research.');
  const n = (s: string) => Number(s.replace(/,/g, ""));
  const src = wf.sources[0];
  withdrawals = {
    completed: n(m[1]),
    approved: n(m[2]),
    withdrawn: n(m[3]),
    share: n(m[4]),
    source: `${src.by}, ${src.year}.${src.checked ? " A person has checked this against the source." : " Not yet checked by a person."}`,
  };
}

// The "forms-differ" card in findings.json is written by hand. Stop the build if its
// figures no longer match the census, so the card and the section cannot disagree.
const card = findings.find((f) => f.id === "forms-differ");
if (card) {
  const qs = differ.questions.flatMap((r) => r.values).sort((a, b) => a - b);
  const m = (id: string) => differ.measures.find((x) => x.id === id)!.rows;
  const sum = (rows: { yes: number; of: number }[], k: "yes" | "of") => rows.reduce((n, r) => n + r[k], 0);
  const spare = m("spare-room");
  const ifa = spare.find((r) => r.group === "Independent agencies");
  const pub = spare.find((r) => r.group === "Councils and hubs");
  const expected = [
    `read ${differ.read} enquiry forms`,
    `shortest asked ${qs[0]} questions and the longest asked ${qs.at(-1)}`,
    `${ifa?.yes === ifa?.of ? "All" : ifa?.yes + " of the"} ${ifa?.of} independent agency forms asked about a spare room`,
    `${pub?.yes ? pub.yes + " of the" : "none of the"} ${pub?.of} council and hub forms`,
    `${sum(m("reply-time"), "yes")} of the ${sum(m("reply-time"), "of")} forms where we looked for a reply time`,
  ];
  const stale = expected.filter((e) => !card.summary.includes(e));
  if (stale.length)
    throw new Error(`evidence/findings.json "forms-differ" no longer matches the census. Update it to say: ${stale.join("; ")}`);
}
---
<Base
  title="Research: what we know about the first step | Kinderform"
  description="What research and our own reading of enquiry forms tell us about the first step into fostering and adoption. Each claim says whether a person has checked it."
>
  <ResearchIndex
    updated={findingsFile.updated}
    findings={findings}
    library={{
      href: "/research/library",
      title: "Evidence library",
      when: libUpdated ? `Updated ${longDate(libUpdated)}` : "Evidence library",
      blurb: "Every source we have found on enquiries, assessment and why carers stay or leave. We sum up each one in our own words and note the gaps we know about.",
    }}
    reports={reports.map((r) => ({
      href: hrefOf(r.id),
      title: titleOf(r.body).replace(/,? and a refined OUCM open standard$/i, ""),
      when: monthOf(r.id),
      blurb: "A review of existing research on what happens after someone gets in touch. We made it with an AI-assisted research tool. Most figures are not yet checked by a person.",
    }))}
    updates={updates.map((u) => ({ href: hrefOf(u.id), title: titleOf(u.body), when: monthOf(u.id) }))}
    formsDiffer={differ}
    us={us}
    world={world}
    withdrawals={withdrawals}
  />
</Base>
