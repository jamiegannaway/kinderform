---
import Base from "@/layouts/Base.astro";
import ResearchIndex, { longDate } from "@/components/research";
import { getCollection } from "astro:content";
import { evidenceEntries, hrefOf, libraryUpdated, monthOf, titleOf } from "@/lib/research";
import findingsFile from "../../../../evidence/findings.json";

// Keep the order of findings.json: it is the order we want people to read them in.
const order = findingsFile.findings.map((f) => f.id);
const findings = (await getCollection("findings"))
  .map((f) => f.data)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const { library, reports, updates } = await evidenceEntries();
const libUpdated = libraryUpdated(library?.body);
---
<Base
  title="Research: what we know about the first step | Kinderform"
  description="What research says about the time between someone getting in touch about fostering or adoption and their application, with every claim marked as checked or not yet checked."
>
  <ResearchIndex
    updated={findingsFile.updated}
    findings={findings}
    library={{
      href: "/research/library",
      title: "Evidence library",
      when: libUpdated ? `Updated ${longDate(libUpdated)}` : "Evidence library",
      blurb: "Every source we have found on enquiries, assessment and why carers stay or leave, each summarised in our own words, with the gaps we know about.",
    }}
    reports={reports.map((r) => ({
      href: hrefOf(r.id),
      title: titleOf(r.body).replace(/,? and a refined OUCM open standard$/i, ""),
      when: monthOf(r.id),
      blurb: "A desk review of what happens after someone gets in touch, made with an AI-assisted research tool. Most figures are not yet checked by a person.",
    }))}
    updates={updates.map((u) => ({ href: hrefOf(u.id), title: titleOf(u.body), when: monthOf(u.id) }))}
  />
</Base>
