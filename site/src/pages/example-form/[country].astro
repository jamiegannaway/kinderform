---
// One country's example form, on its own page. ?design=neutral shows the neutral design, and
// ?lang=fr the French version of a form that has one (Canada).
import Base from "@/layouts/Base.astro";
import { ExampleFormPage } from "@/components/example-form-page";
import { DESIGN_SYSTEMS } from "@/lib/design-systems";
import { downloads, exampleForms, type ExampleForm } from "@/lib/example-forms";

export function getStaticPaths() {
  return exampleForms().map((form) => ({ params: { country: form.code }, props: { form } }));
}
const { form } = Astro.props as { form: ExampleForm };
const files = Object.fromEntries(form.variants.map((v) => [v.key, downloads(form, v)]));
const designs = form.system ? `in ${DESIGN_SYSTEMS[form.system].short} and in a neutral design` : "in a neutral design";
---
<Base
  title={`${form.name}: example enquiry form | Kinderform`}
  description={`Try an example enquiry form for fostering or adoption in ${form.inSentence}, ${designs}. Nothing you enter is sent.`}
>
  <script is:inline slot="head" src="/example-form.js"></script>
  <ExampleFormPage form={form} files={files} />
  <script>
    import "@/components/reference-form/mount-page";
  </script>
</Base>
