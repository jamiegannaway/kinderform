---
import Base from "@/layouts/Base.astro";
import { ExampleIntro, ExampleOutro } from "@/components/example-form-shell";
import "@/styles/govuk.scss";
import "@/components/reference-form/kf-form.css";
---
<Base
  title="Example enquiry form (UK) | Kinderform"
  description="The Kinderform enquiry standard working: a short, kind first form for people asking about fostering or adoption."
>
  <ExampleIntro variant="uk" />
  <main id="main" class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl rounded-xl border bg-white p-6 text-black md:p-10">
      <div id="kf-form">
        <noscript>
          <p>This example needs JavaScript. A form built to the Kinderform standard for real use should work without it.</p>
        </noscript>
      </div>
    </div>
  </main>
  <ExampleOutro />
  <script>
    import "@/components/reference-form/mount-uk";
  </script>
</Base>
