---
import Base from "@/layouts/Base.astro";
import { ExampleIntro, ExampleOutro } from "@/components/example-form-shell";
import "@/styles/uswds.scss";
import "@/components/reference-form/kf-form.css";
---
<Base
  title="Example enquiry form (US) | Kinderform"
  description="The Kinderform enquiry standard working in US English, using the U.S. Web Design System."
>
  <ExampleIntro variant="us" />
  <main id="main" class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl rounded-xl border bg-white p-6 text-black md:p-10">
      <div id="kf-form" class="kf-us">
        <noscript>
          <p>This example needs JavaScript. A form built to the Kinderform standard for real use should work without it.</p>
        </noscript>
      </div>
    </div>
  </main>
  <ExampleOutro />
  <script>
    import "@/components/reference-form/mount-us";
  </script>
</Base>
