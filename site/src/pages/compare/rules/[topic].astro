---
// One page per rules topic: every place side by side.
import Base from "@/layouts/Base.astro";
import { CompareTopic } from "@/components/compare";
import { countryList, loadTopics, ruleRows, type TopicInfo } from "@/lib/compare";

export function getStaticPaths() {
  const rules = ruleRows();
  return loadTopics()
    .filter((t) => rules.some((r) => r.topic === t.code))
    .map((t) => ({ params: { topic: t.code }, props: { topic: t } }));
}
const { topic } = Astro.props as { topic: TopicInfo };
const rows = ruleRows().filter((r) => r.topic === topic.code);
const countries = countryList(rows.map((row) => row.country));
---
<Base
  title={`${topic.label}: rules compared | Kinderform`}
  description={`Compare published rules for ${topic.label.toLowerCase()} in ${countries}, with links to sources and the dates we checked them.`}
>
  <CompareTopic topic={topic} rows={rows} />
</Base>
