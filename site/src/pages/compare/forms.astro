---
import Base from "@/layouts/Base.astro";
import { CompareForms } from "@/components/compare";
import { loadCensus } from "@/lib/census";
import { formRows } from "@/lib/compare";

const rows = formRows(loadCensus());
---
<Base
  title="Enquiry forms compared | Kinderform"
  description="Every fostering and adoption enquiry form we have read in the UK, the US, Canada and Australia: what each asks, any reply time it states, the link and two dates."
>
  <CompareForms rows={rows} />
</Base>
