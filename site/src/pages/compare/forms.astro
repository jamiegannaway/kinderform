---
import Base from "@/layouts/Base.astro";
import { CompareForms } from "@/components/compare";
import { loadCensus } from "@/lib/census";
import { countryList, formRows } from "@/lib/compare";

const rows = formRows(loadCensus());
const countries = countryList(rows.map((row) => row.country));
---
<Base
  title="Enquiry forms compared | Kinderform"
  description={`Compare the fostering and adoption enquiry forms we have recorded across ${countries}. See what each asks, its published reply time and when we checked it.`}
>
  <CompareForms rows={rows} />
</Base>
