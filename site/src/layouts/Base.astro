---
import "@/styles/globals.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content="Kinderform" />
    <meta property="og:description" content="Everyone who offers to care for a child deserves a quick, kind and considered reply." />
    <meta property="og:url" content="https://www.kinderform.org/" />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-svh">
    <slot />
  </body>
</html>
