{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kinderform.org/schema/enquiry-submission/0.1.json",
  "title": "Enquiry submission",
  "description": "What a person tells a fostering or adoption service when they first get in touch. It holds only what the service needs to reply. Nothing about health, the household, the home, money, work, convictions, ethnicity, religion, sexuality, gender identity, date of birth or full address. Fields it does not define are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["full_name", "interest", "knows_child", "contact_method"],
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 100,
      "description": "One field, so the reply can be personal."
    },
    "preferred_name": {
      "type": "string",
      "maxLength": 50,
      "description": "What the person would like to be called."
    },
    "interest": {
      "type": "string",
      "enum": ["fostering", "adoption", "not_sure"],
      "description": "'not_sure' is a real answer: the service talks through both."
    },
    "knows_child": {
      "type": "boolean",
      "description": "True routes the enquiry to the kinship team. Nothing about the child is recorded."
    },
    "contact_method": {
      "type": "string",
      "enum": ["email", "phone_call", "text_message"]
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "phone": {
      "type": "string",
      "description": "7 to 15 digits, with an optional leading plus and spaces, brackets or hyphens. Formatting alone is not a phone number; this check does not prove reachability.",
      "pattern": "^(?=(?:[^0-9]*[0-9]){7,15}[^0-9]*$)\\+?[0-9() \\-]{7,30}$"
    },
    "best_times": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["weekday_morning", "weekday_afternoon", "weekday_evening", "saturday"] },
      "description": "Only asked when the person chose a phone call. Evening and Saturday are always offered."
    },
    "postcode_area": {
      "type": "string",
      "pattern": "^[A-Z]{1,2}[0-9][0-9A-Z]?$",
      "description": "UK only. The outward part of the postcode, enough to find the local team."
    },
    "zip_prefix": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "US only. The first three digits of the ZIP code, enough to find the local agency."
    },
    "postal_code_fsa": {
      "type": "string",
      "pattern": "^[ABCEGHJ-NPRSTVXY][0-9][ABCEGHJ-NPRSTV-Z]$",
      "description": "Canada only. The first three characters of the postal code (the forward sortation area), enough to find the local agency."
    },
    "au_postcode": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "Australia only. The four-digit postcode, which covers a suburb or town, enough to find the local agency."
    },
    "de_postcode": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "description": "Germany only. The five-digit postcode (Postleitzahl). Where a person lives decides which youth welfare office (Jugendamt) handles their enquiry."
    },
    "fr_postcode": {
      "type": "string",
      "pattern": "^(?:0[1-9]|[1-8][0-9]|9[0-8])[0-9]{3}$",
      "description": "France only. The five-digit postcode (code postal). Its first digits give the département, whose council handles fostering and adoption."
    },
    "es_postcode": {
      "type": "string",
      "pattern": "^(?:0[1-9]|[1-4][0-9]|5[0-2])[0-9]{3}$",
      "description": "Spain only. The five-digit postcode (código postal). Its first two digits give the province, which shows the autonomous community that handles foster care and adoption."
    },
    "eircode_routing_key": {
      "type": "string",
      "pattern": "^(?:[AC-FHKNPRTV-Y][0-9]{2}|D6W)$",
      "description": "Ireland only. The first three characters of the Eircode (the routing key), enough to find the local Tusla area. The full Eircode identifies one address, so it is not asked for."
    },
    "nl_postcode": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}$",
      "description": "Netherlands only. The four digits of the postcode, without the two letters that narrow it to a street. Enough to find the foster care provider for the area."
    },
    "nz_postcode": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "New Zealand only. The four-digit postcode, enough to find the nearest Oranga Tamariki site or care partner."
    },
    "no_postcode": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "Norway only. The four-digit postcode (postnummer), enough to find the municipality or the Bufetat office that recruits foster homes there."
    },
    "dk_postcode": {
      "type": "string",
      "pattern": "^[1-9][0-9]{3}$",
      "description": "Denmark only. The four-digit postcode, enough to find the municipality (kommune) that recruits foster families there."
    },
    "se_postcode_area": {
      "type": "string",
      "pattern": "^[1-9][0-9]{2}$",
      "description": "Sweden only. The first three digits of the five-digit postcode (postnummer), enough to find the municipality (kommun). The full postcode narrows to a few streets, so it is not asked for."
    },
    "fi_postcode_area": {
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "description": "Finland only. The first three digits of the five-digit postcode (postinumero), enough to find the wellbeing services county. The full postcode narrows to a small area, so it is not asked for."
    },
    "contact_language": {
      "type": "string",
      "enum": ["english", "french"],
      "description": "Canada only. The official language the person would like the reply in."
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["eligibility", "what_it_involves", "money_and_support", "process_and_timescales", "types_of_care", "something_else"]
      },
      "description": "Coded, never free text, so nobody shares sensitive details by accident."
    },
    "heard_from": {
      "type": "string",
      "enum": ["friend_or_family", "social_media", "search", "event", "advert", "council_or_agency_website", "other"]
    },
    "updates_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in only. Never pre-ticked."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contact_method": { "const": "email" } }, "required": ["contact_method"] },
      "then": { "required": ["email"], "properties": { "phone": false, "best_times": false } }
    },
    {
      "if": { "properties": { "contact_method": { "enum": ["phone_call", "text_message"] } }, "required": ["contact_method"] },
      "then": { "required": ["phone"], "properties": { "email": false } }
    },
    {
      "if": { "properties": { "contact_method": { "const": "text_message" } }, "required": ["contact_method"] },
      "then": { "properties": { "best_times": false } }
    },
    {
      "$comment": "At most one location field: each belongs to one country.",
      "not": {
        "anyOf": [
          { "required": ["postcode_area", "zip_prefix"] },
          { "required": ["postcode_area", "postal_code_fsa"] },
          { "required": ["postcode_area", "au_postcode"] },
          { "required": ["postcode_area", "de_postcode"] },
          { "required": ["postcode_area", "fr_postcode"] },
          { "required": ["postcode_area", "es_postcode"] },
          { "required": ["postcode_area", "eircode_routing_key"] },
          { "required": ["postcode_area", "nl_postcode"] },
          { "required": ["postcode_area", "nz_postcode"] },
          { "required": ["postcode_area", "no_postcode"] },
          { "required": ["postcode_area", "dk_postcode"] },
          { "required": ["postcode_area", "se_postcode_area"] },
          { "required": ["postcode_area", "fi_postcode_area"] },
          { "required": ["zip_prefix", "postal_code_fsa"] },
          { "required": ["zip_prefix", "au_postcode"] },
          { "required": ["zip_prefix", "de_postcode"] },
          { "required": ["zip_prefix", "fr_postcode"] },
          { "required": ["zip_prefix", "es_postcode"] },
          { "required": ["zip_prefix", "eircode_routing_key"] },
          { "required": ["zip_prefix", "nl_postcode"] },
          { "required": ["zip_prefix", "nz_postcode"] },
          { "required": ["zip_prefix", "no_postcode"] },
          { "required": ["zip_prefix", "dk_postcode"] },
          { "required": ["zip_prefix", "se_postcode_area"] },
          { "required": ["zip_prefix", "fi_postcode_area"] },
          { "required": ["postal_code_fsa", "au_postcode"] },
          { "required": ["postal_code_fsa", "de_postcode"] },
          { "required": ["postal_code_fsa", "fr_postcode"] },
          { "required": ["postal_code_fsa", "es_postcode"] },
          { "required": ["postal_code_fsa", "eircode_routing_key"] },
          { "required": ["postal_code_fsa", "nl_postcode"] },
          { "required": ["postal_code_fsa", "nz_postcode"] },
          { "required": ["postal_code_fsa", "no_postcode"] },
          { "required": ["postal_code_fsa", "dk_postcode"] },
          { "required": ["postal_code_fsa", "se_postcode_area"] },
          { "required": ["postal_code_fsa", "fi_postcode_area"] },
          { "required": ["au_postcode", "de_postcode"] },
          { "required": ["au_postcode", "fr_postcode"] },
          { "required": ["au_postcode", "es_postcode"] },
          { "required": ["au_postcode", "eircode_routing_key"] },
          { "required": ["au_postcode", "nl_postcode"] },
          { "required": ["au_postcode", "nz_postcode"] },
          { "required": ["au_postcode", "no_postcode"] },
          { "required": ["au_postcode", "dk_postcode"] },
          { "required": ["au_postcode", "se_postcode_area"] },
          { "required": ["au_postcode", "fi_postcode_area"] },
          { "required": ["de_postcode", "fr_postcode"] },
          { "required": ["de_postcode", "es_postcode"] },
          { "required": ["de_postcode", "eircode_routing_key"] },
          { "required": ["de_postcode", "nl_postcode"] },
          { "required": ["de_postcode", "nz_postcode"] },
          { "required": ["de_postcode", "no_postcode"] },
          { "required": ["de_postcode", "dk_postcode"] },
          { "required": ["de_postcode", "se_postcode_area"] },
          { "required": ["de_postcode", "fi_postcode_area"] },
          { "required": ["fr_postcode", "es_postcode"] },
          { "required": ["fr_postcode", "eircode_routing_key"] },
          { "required": ["fr_postcode", "nl_postcode"] },
          { "required": ["fr_postcode", "nz_postcode"] },
          { "required": ["fr_postcode", "no_postcode"] },
          { "required": ["fr_postcode", "dk_postcode"] },
          { "required": ["fr_postcode", "se_postcode_area"] },
          { "required": ["fr_postcode", "fi_postcode_area"] },
          { "required": ["es_postcode", "eircode_routing_key"] },
          { "required": ["es_postcode", "nl_postcode"] },
          { "required": ["es_postcode", "nz_postcode"] },
          { "required": ["es_postcode", "no_postcode"] },
          { "required": ["es_postcode", "dk_postcode"] },
          { "required": ["es_postcode", "se_postcode_area"] },
          { "required": ["es_postcode", "fi_postcode_area"] },
          { "required": ["eircode_routing_key", "nl_postcode"] },
          { "required": ["eircode_routing_key", "nz_postcode"] },
          { "required": ["eircode_routing_key", "no_postcode"] },
          { "required": ["eircode_routing_key", "dk_postcode"] },
          { "required": ["eircode_routing_key", "se_postcode_area"] },
          { "required": ["eircode_routing_key", "fi_postcode_area"] },
          { "required": ["nl_postcode", "nz_postcode"] },
          { "required": ["nl_postcode", "no_postcode"] },
          { "required": ["nl_postcode", "dk_postcode"] },
          { "required": ["nl_postcode", "se_postcode_area"] },
          { "required": ["nl_postcode", "fi_postcode_area"] },
          { "required": ["nz_postcode", "no_postcode"] },
          { "required": ["nz_postcode", "dk_postcode"] },
          { "required": ["nz_postcode", "se_postcode_area"] },
          { "required": ["nz_postcode", "fi_postcode_area"] },
          { "required": ["no_postcode", "dk_postcode"] },
          { "required": ["no_postcode", "se_postcode_area"] },
          { "required": ["no_postcode", "fi_postcode_area"] },
          { "required": ["dk_postcode", "se_postcode_area"] },
          { "required": ["dk_postcode", "fi_postcode_area"] },
          { "required": ["se_postcode_area", "fi_postcode_area"] }
        ]
      }
    }
  ]
}
