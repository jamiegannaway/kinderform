{
  "version": "0.1",
  "status": "draft",
  "description": "Tags for every field of every Kinderform schema. A service maps each tag to its own policy. v0.1 draft: not legal advice, not checked by a person.",
  "sensitivity_classes": {
    "operational": "Identifiers, times and codes. Still private when combined.",
    "location_coarse": "A coarse place code, such as the start of a postcode.",
    "personal": "Something that names or describes a person.",
    "personal_contact": "A way to reach a person, such as an email address or phone number.",
    "special_category": "A class of data that law treats as especially sensitive. No Kinderform field uses it.",
    "criminal_offence": "Data about offences or convictions. No Kinderform field uses it."
  },
  "purposes": {
    "reply": "Used to answer the person.",
    "route": "Used to send the enquiry to the right team.",
    "measure_service": "Used to measure how the service replies, never how staff perform.",
    "keep_in_touch": "Used to contact the person again when they agreed.",
    "audit": "Used to show what happened and when.",
    "retention": "Used to decide when to keep or delete the record."
  },
  "retention_classes": {
    "contact_details": "Names and ways to reach a person. Map to the shortest period the service's policy allows.",
    "enquiry_record": "The monitoring record of an enquiry, without names or contact details.",
    "event_log": "The append-only interaction log, kept in segments so an old segment can be deleted whole."
  },
  "ai_use": {
    "no": "Never give this field to an AI tool.",
    "as_data_only": "May be given only inside a marked data block, never as instructions.",
    "yes": "A coded value that is safe to pass."
  },
